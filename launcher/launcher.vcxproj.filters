<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup>
    <Filter Include="Source">
      <UniqueIdentifier>{B1C2D3E4-F5A6-7890-BCDE-F01234567891}</UniqueIdentifier>
    </Filter>
    <Filter Include="ImGui">
      <UniqueIdentifier>{C2D3E4F5-A6B7-8901-CDEF-012345678902}</UniqueIdentifier>
    </Filter>
    <Filter Include="ImGui\Backends">
      <UniqueIdentifier>{D3E4F5A6-B7C8-9012-DEF0-123456789013}</UniqueIdentifier>
    </Filter>
    <Filter Include="Headers">
      <UniqueIdentifier>{E4F5A6B7-C8D9-0123-EF01-234567890124}</UniqueIdentifier>
    </Filter>
  </ItemGroup>

  <ItemGroup>
    <!-- Launcher source -->
    <ClCompile Include="launcher.cpp">
      <Filter>Source</Filter>
    </ClCompile>

    <!-- ImGui core -->
    <ClCompile Include="$(ImGuiDir)\imgui.cpp">
      <Filter>ImGui</Filter>
    </ClCompile>
    <ClCompile Include="$(ImGuiDir)\imgui_draw.cpp">
      <Filter>ImGui</Filter>
    </ClCompile>
    <ClCompile Include="$(ImGuiDir)\imgui_tables.cpp">
      <Filter>ImGui</Filter>
    </ClCompile>
    <ClCompile Include="$(ImGuiDir)\imgui_widgets.cpp">
      <Filter>ImGui</Filter>
    </ClCompile>

    <!-- ImGui backends -->
    <ClCompile Include="$(ImGuiDir)\backends\imgui_impl_win32.cpp">
      <Filter>ImGui\Backends</Filter>
    </ClCompile>
    <ClCompile Include="$(ImGuiDir)\backends\imgui_impl_dx11.cpp">
      <Filter>ImGui\Backends</Filter>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <!-- ImGui headers -->
    <ClInclude Include="$(ImGuiDir)\imgui.h">
      <Filter>Headers</Filter>
    </ClInclude>
    <ClInclude Include="$(ImGuiDir)\imgui_internal.h">
      <Filter>Headers</Filter>
    </ClInclude>
    <ClInclude Include="$(ImGuiDir)\backends\imgui_impl_win32.h">
      <Filter>Headers</Filter>
    </ClInclude>
    <ClInclude Include="$(ImGuiDir)\backends\imgui_impl_dx11.h">
      <Filter>Headers</Filter>
    </ClInclude>
  </ItemGroup>

</Project>
